model Order {
  id                     String        @id @default(uuid()) @db.Uuid
  orderNumber            String        @unique @map("order_number") @db.VarChar(40)
  customerId             String        @map("customer_id") @db.Uuid
  customerProfileId      String?       @map("customer_profile_id") @db.Uuid
  recommendationResultId String?       @map("recommendation_result_id") @db.Uuid
  selectedPackId         String?       @map("selected_pack_id") @db.Uuid
  customerAddressId      String        @map("customer_address_id") @db.Uuid
  paymentMethod          PaymentMethod @default(CASH_ON_DELIVERY) @map("payment_method")
  paymentStatus          PaymentStatus @default(UNPAID) @map("payment_status")
  orderStatus            OrderStatus   @default(PENDING_CONFIRMATION) @map("order_status")
  subtotalAmount         Decimal       @default(0) @map("subtotal_amount") @db.Decimal(10, 2)
  discountAmount         Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  deliveryFee            Decimal       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount            Decimal       @default(0) @map("total_amount") @db.Decimal(10, 2)
  currency               String        @default("MAD") @db.Char(3)
  notes                  String?

  // Pack Core Evolution (Phase 3) — additive, immutable pack-configuration
  // snapshot. Frozen at order creation to preserve the configured composition,
  // final validated price, floor, currency, and validation outcome even if the
  // source pack/product later changes. Null for all legacy/non-configured orders.
  // Never stores private quiz answers, internal scores, costs, or margins.
  packConfigurationSnapshot Json? @map("pack_configuration_snapshot")

  // Pack Core Evolution (Phase 6) — additive, nullable link to the persisted
  // PackConfiguration this order was checked out from (if any). Null for legacy,
  // recommendation-funnel, cart, and fixed-pack orders.
  packConfigurationId String? @map("pack_configuration_id") @db.Uuid

  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerProfile      CustomerProfile?      @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  recommendationResult RecommendationResult? @relation(fields: [recommendationResultId], references: [id], onDelete: SetNull)
  selectedPack         Pack?                 @relation("SelectedPackOrders", fields: [selectedPackId], references: [id], onDelete: Restrict)
  customerAddress      CustomerAddress       @relation(fields: [customerAddressId], references: [id], onDelete: Restrict)
  packConfiguration    PackConfiguration?    @relation("PackConfigurationOrders", fields: [packConfigurationId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  messages      MessageLog[]
  reviews       Review[]

  @@index([customerId])
  @@index([customerProfileId])
  @@index([recommendationResultId])
  @@index([selectedPackId])
  @@index([customerAddressId])
  @@index([packConfigurationId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                        String   @id @default(uuid()) @db.Uuid
  orderId                   String   @map("order_id") @db.Uuid
