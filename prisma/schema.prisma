generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum SourceChannel {
  INSTAGRAM
  WHATSAPP
  TIKTOK
  FACEBOOK
  DIRECT
  OTHER
}

enum SelectionType {
  SINGLE
  MULTIPLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum VariationType {
  SHADE
  SIZE
  BUNDLE
}

enum PackStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PriceMode {
  FIXED
  SUM_ITEMS
  SUM_ITEMS_WITH_DISCOUNT
}

enum SelectionMode {
  FIXED_REFERENCE
  AUTO_BEST_REFERENCE
  CUSTOMER_CHOICE
}

enum PackItemRole {
  FIXED
  REQUIRED_SELECTABLE
  OPTIONAL_INCLUDED
  OPTIONAL_ADDON
}

// Pack Core Evolution (Phase 4A) — public catalog discovery facets. These are
// coarse marketing classifications used only for browsing/filtering. They are
// intentionally distinct from PackCompatibilityProfile (which expresses the full
// suitability set consumed by the recommendation engine) and are never used for
// scoring, pricing, or eligibility.
enum PackTier {
  ESSENTIAL
  PREMIUM
  LUXE
}

enum PackOccasion {
  EVERYDAY
  WORK
  EVENING
  PARTY
  WEDDING
  SPECIAL_EVENT
}

enum PackExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum MatchType {
  COMPATIBLE
  NOT_COMPATIBLE
  BOOST
}

// Pack Core Evolution (Phase 2.5) — the five admin-managed compatibility
// dimensions a Pack can express suitability for. Each criterion maps to a
// canonical AttributeGroup (single source of truth shared with the quiz):
//   SKIN_TONE -> SKIN_COLOR, SKIN_TYPE -> SKIN_TYPE, MAKEUP_STYLE -> STYLE,
//   BUDGET -> BUDGET, OCCASION -> OCCASION.
enum PackCompatibilityCriterion {
  SKIN_TONE
  SKIN_TYPE
  MAKEUP_STYLE
  BUDGET
  OCCASION
}

// Per-criterion applicability mode. Absence of a profile row for a (pack,
// criterion) means UNCONFIGURED (legacy default) — distinct from an explicit
// UNIVERSAL row. UNIVERSAL needs no values; RESTRICTED needs >= 1 value.
enum PackCompatibilityMode {
  UNIVERSAL
  RESTRICTED
}

// Pack Core Evolution (Phase 6) — how a persisted PackConfiguration originated.
// Mirrors the string union used by the Order snapshot builder. Phase 6 only
// persists CUSTOMIZED configurations; the other values are reserved for later
// phases (fixed capture, quiz recommendation, generated packs).
enum PackConfigurationSourceType {
  FIXED
  CUSTOMIZED
  QUIZ_RECOMMENDED
  QUIZ_GENERATED
}

enum RecommendationTargetType {
  PACK
  PRODUCT
  REFERENCE
}

enum RecommendationConditionType {
  MUST_MATCH
  SHOULD_MATCH
  EXCLUDE_IF_MATCH
}

enum RecommendationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
}

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum MediaAssetProvider {
  CLOUDINARY
}

enum MediaAssetType {
  IMAGE
}

enum MediaRole {
  COVER
  GALLERY
  THUMBNAIL
  SWATCH
  ICON
}

/**
 * =========================================================
 * 1. ATTRIBUTES / QUIZ FOUNDATION
 * =========================================================
 */

model AttributeGroup {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(80)
  name                String   @db.VarChar(120)
  description         String?
  isCustomerAttribute Boolean  @default(false) @map("is_customer_attribute")
  isProductAttribute  Boolean  @default(false) @map("is_product_attribute")
  sortOrder           Int      @default(0) @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  options                    AttributeOption[]
  quizQuestions              QuizQuestion[]
  customerProfileAnswers     CustomerProfileAnswer[]
  productReferenceAttributes ProductReferenceAttribute[]
  productAttributes          ProductAttribute[]
  packAttributes             PackAttribute[]
  recommendationRules        RecommendationRule[]

  @@map("attribute_groups")
}

model AttributeOption {
  id               String   @id @default(uuid()) @db.Uuid
  attributeGroupId String   @map("attribute_group_id") @db.Uuid
  code             String   @db.VarChar(80)
  label            String   @db.VarChar(120)
  description      String?
  imageUrl         String?  @map("image_url")
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  minNumericValue  Decimal? @map("min_numeric_value") @db.Decimal(10, 2)
  maxNumericValue  Decimal? @map("max_numeric_value") @db.Decimal(10, 2)

  attributeGroup AttributeGroup @relation(fields: [attributeGroupId], references: [id], onDelete: Cascade)

  quizQuestionOptions        QuizQuestionOption[]
  customerProfileAnswers     CustomerProfileAnswer[]
  productReferenceAttributes ProductReferenceAttribute[]
  productAttributes          ProductAttribute[]
  packAttributes             PackAttribute[]
  packCompatibilityValues    PackCompatibilityValue[]

  @@unique([attributeGroupId, code])
  @@index([attributeGroupId])
  @@map("attribute_options")
}

model QuizQuestion {
  id               String        @id @default(uuid()) @db.Uuid
  attributeGroupId String?       @map("attribute_group_id") @db.Uuid
  questionText     String        @map("question_text")
  helperText       String?       @map("helper_text")
  selectionType    SelectionType @default(SINGLE) @map("selection_type")
  isRequired       Boolean       @default(true) @map("is_required")
  stepOrder        Int           @default(0) @map("step_order")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  attributeGroup AttributeGroup? @relation(fields: [attributeGroupId], references: [id], onDelete: SetNull)

  options QuizQuestionOption[]
  answers CustomerProfileAnswer[]

  @@index([attributeGroupId])
  @@index([stepOrder])
  @@map("quiz_questions")
}

model QuizQuestionOption {
  id                String  @id @default(uuid()) @db.Uuid
  questionId        String  @map("question_id") @db.Uuid
  attributeOptionId String  @map("attribute_option_id") @db.Uuid
  displayLabel      String? @map("display_label") @db.VarChar(120)
  displayImageUrl   String? @map("display_image_url")
  sortOrder         Int     @default(0) @map("sort_order")
  isActive          Boolean @default(true) @map("is_active")

  question        QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attributeOption AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Restrict)

  @@unique([questionId, attributeOptionId])
  @@index([questionId])
  @@index([attributeOptionId])
  @@map("quiz_question_options")
}

/**
 * =========================================================
 * 2. CUSTOMER PROFILE / QUIZ ANSWERS
 * =========================================================
 */

model CustomerProfile {
  id               String        @id @default(uuid()) @db.Uuid
  sessionToken     String        @unique @map("session_token") @db.VarChar(255)
  sourceChannel    SourceChannel @default(DIRECT) @map("source_channel")
  algorithmVersion String        @default("v1") @map("algorithm_version") @db.VarChar(20)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  answers                CustomerProfileAnswer[]
  recommendationSessions RecommendationSession[]
  orders                 Order[]
  events                 CustomerEvent[]
  wishlistItems          WishlistItem[]

  @@index([sourceChannel])
  @@index([createdAt])
  @@map("customer_profiles")
}

model CustomerProfileAnswer {
  id                String   @id @default(uuid()) @db.Uuid
  customerProfileId String   @map("customer_profile_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  attributeGroupId  String   @map("attribute_group_id") @db.Uuid
  attributeOptionId String?  @map("attribute_option_id") @db.Uuid
  valueText         String?  @map("value_text")
  createdAt         DateTime @default(now()) @map("created_at")

  customerProfile CustomerProfile  @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  question        QuizQuestion     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  attributeGroup  AttributeGroup   @relation(fields: [attributeGroupId], references: [id], onDelete: Restrict)
  attributeOption AttributeOption? @relation(fields: [attributeOptionId], references: [id], onDelete: Restrict)

  @@index([customerProfileId])
  @@index([questionId])
  @@index([attributeGroupId])
  @@index([attributeOptionId])
  @@map("customer_profile_answers")
}

/**
 * Pack Core Evolution (Phase 8A) — Universal Wishlist foundation.
 *
 * A WishlistItem is owned by the anonymous session (`CustomerProfile`, the same
 * `sessionToken` identity produced by the quiz). It saves exactly one of a public
 * PRODUCT or a public PACK; `targetType` records which. `productId`/`packId` are
 * real, cascading foreign keys (only one is ever set per row), so the wishlist
 * stays consistent if the underlying catalog entry is later removed.
 *
 * Duplicate protection is enforced at the database level per owner + target via
 * two composite unique indexes. Postgres treats NULLs as distinct, so a
 * `(profile, productId)` unique never conflicts across the NULL productId of
 * PACK rows (and vice versa). PackConfiguration wishlisting is intentionally out
 * of scope for this phase.
 */
enum WishlistTargetType {
  PRODUCT
  PACK
}

model WishlistItem {
  id                String             @id @default(uuid()) @db.Uuid
  customerProfileId String             @map("customer_profile_id") @db.Uuid
  targetType        WishlistTargetType @map("target_type")
  productId         String?            @map("product_id") @db.Uuid
  packId            String?            @map("pack_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  pack            Pack?           @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([customerProfileId, productId])
  @@unique([customerProfileId, packId])
  @@index([customerProfileId])
  @@index([productId])
  @@index([packId])
  @@map("wishlist_items")
}

/**
 * =========================================================
 * 3. PRODUCT CATALOG
 * =========================================================
 */

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String?
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products Product[]
  packs    Pack[]
  image    CategoryImage?

  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(120)
  description String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  brandId          String?       @map("brand_id") @db.Uuid
  name             String        @db.VarChar(180)
  slug             String        @unique @db.VarChar(200)
  productType      String?       @map("product_type") @db.VarChar(60)
  shortDescription String?       @map("short_description") @db.VarChar(280)
  description      String?
  ingredients      String?       @db.Text
  directions       String?       @db.Text
  basePrice        Decimal       @map("base_price") @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  costPrice        Decimal?      @map("cost_price") @db.Decimal(10, 2)
  currency         String        @default("MAD") @db.Char(3)
  metaTitle        String?       @map("meta_title") @db.VarChar(180)
  metaDescription  String?       @map("meta_description") @db.VarChar(320)
  mainImageUrl     String?       @map("main_image_url")
  status           ProductStatus @default(DRAFT)
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)

  references                ProductReference[]
  attributes                ProductAttribute[]
  images                    ProductImage[]
  packItems                 PackItem[]
  packAllowedAddOns         PackAllowedAddOn[]
  recommendationResultItems RecommendationResultItem[]
  orderItems                OrderItem[]
  wishlistItems             WishlistItem[]
  reviews                   Review[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isActive])
  @@index([productType])
  @@index([status, categoryId])
  @@map("products")
}

model ProductReference {
  id                String         @id @default(uuid()) @db.Uuid
  productId         String         @map("product_id") @db.Uuid
  referenceCode     String         @map("reference_code") @db.VarChar(80)
  referenceName     String         @map("reference_name") @db.VarChar(160)
  shadeName         String?        @map("shade_name") @db.VarChar(120)
  shadeCode         String?        @map("shade_code") @db.VarChar(60)
  swatchHex         String?        @map("swatch_hex") @db.VarChar(7)
  measurement       String?        @db.VarChar(40)
  variationType     VariationType? @map("variation_type")
  barcode           String?        @unique @db.VarChar(120)
  sku               String?        @unique @db.VarChar(120)
  priceOverride     Decimal?       @map("price_override") @db.Decimal(10, 2)
  priceDelta        Decimal        @default(0) @map("price_delta") @db.Decimal(10, 2)
  imageUrl          String?        @map("image_url")
  stockQuantity     Int            @default(0) @map("stock_quantity")
  reservedQuantity  Int            @default(0) @map("reserved_quantity")
  lowStockThreshold Int            @default(5) @map("low_stock_threshold")
  isDefault         Boolean        @default(false) @map("is_default")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes                ProductReferenceAttribute[]
  image                     ProductReferenceImage?
  packItems                 PackItem[]
  packItemAllowedReferences PackItemAllowedReference[]
  packAllowedAddOns         PackAllowedAddOn[]
  recommendationResultItems RecommendationResultItem[]
  orderItems                OrderItem[]

  @@unique([productId, referenceCode])
  @@index([productId])
  @@index([isActive])
  @@index([stockQuantity])
  @@index([variationType])
  @@map("product_references")
}

model ProductReferenceAttribute {
  id                 String    @id @default(uuid()) @db.Uuid
  productReferenceId String    @map("product_reference_id") @db.Uuid
  attributeGroupId   String    @map("attribute_group_id") @db.Uuid
  attributeOptionId  String    @map("attribute_option_id") @db.Uuid
  matchType          MatchType @default(COMPATIBLE) @map("match_type")
  scoreValue         Int       @default(0) @map("score_value")
  isHardFilter       Boolean   @default(false) @map("is_hard_filter")
  createdAt          DateTime  @default(now()) @map("created_at")

  productReference ProductReference @relation(fields: [productReferenceId], references: [id], onDelete: Cascade)
  attributeGroup   AttributeGroup   @relation(fields: [attributeGroupId], references: [id], onDelete: Restrict)
  attributeOption  AttributeOption  @relation(fields: [attributeOptionId], references: [id], onDelete: Restrict)

  @@unique([productReferenceId, attributeGroupId, attributeOptionId])
  @@index([productReferenceId])
  @@index([attributeGroupId])
  @@index([attributeOptionId])
  @@index([matchType])
  @@map("product_reference_attributes")
}

model ProductAttribute {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  attributeGroupId  String    @map("attribute_group_id") @db.Uuid
  attributeOptionId String    @map("attribute_option_id") @db.Uuid
  matchType         MatchType @default(COMPATIBLE) @map("match_type")
  scoreValue        Int       @default(0) @map("score_value")
  isHardFilter      Boolean   @default(false) @map("is_hard_filter")
  createdAt         DateTime  @default(now()) @map("created_at")

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeGroup  AttributeGroup  @relation(fields: [attributeGroupId], references: [id], onDelete: Restrict)
  attributeOption AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Restrict)

  @@unique([productId, attributeGroupId, attributeOptionId])
  @@index([productId])
  @@index([attributeGroupId])
  @@index([attributeOptionId])
  @@index([matchType])
  @@map("product_attributes")
}

/**
 * =========================================================
 * 4. PACKS
 * =========================================================
 */

model Pack {
  id                 String     @id @default(uuid()) @db.Uuid
  name               String     @db.VarChar(180)
  slug               String     @unique @db.VarChar(200)
  description        String?
  mainImageUrl       String?    @map("main_image_url")
  priceMode          PriceMode  @default(FIXED) @map("price_mode")
  fixedPrice         Decimal?   @map("fixed_price") @db.Decimal(10, 2)
  discountAmount     Decimal?   @map("discount_amount") @db.Decimal(10, 2)
  discountPercentage Decimal?   @map("discount_percentage") @db.Decimal(5, 2)
  minBudget          Decimal?   @map("min_budget") @db.Decimal(10, 2)
  maxBudget          Decimal?   @map("max_budget") @db.Decimal(10, 2)
  currency           String     @default("MAD") @db.Char(3)
  priority           Int        @default(0)
  status             PackStatus @default(DRAFT)
  isActive           Boolean    @default(true) @map("is_active")

  // Pack Core Evolution (Phase 2) — additive customization foundation.
  // Foundation-only: stored and returned, but inert in current runtime logic.
  isCustomizable   Boolean  @default(false) @map("is_customizable")
  minRequiredItems Int?     @map("min_required_items")
  maxItemCount     Int?     @map("max_item_count")
  minAllowedPrice  Decimal? @map("min_allowed_price") @db.Decimal(10, 2)

  // Pack Core Evolution (Phase 4A) — additive public discovery fields. Optional
  // and defaulted so existing Packs read back byte-identically. `category` reuses
  // the shared Category entity (no PackCategory duplication).
  categoryId      String?              @map("category_id") @db.Uuid
  tier            PackTier?
  occasion        PackOccasion?
  experienceLevel PackExperienceLevel? @map("experience_level")
  isFeatured      Boolean              @default(false) @map("is_featured")
  isNew           Boolean              @default(false) @map("is_new")
  isBestSeller    Boolean              @default(false) @map("is_best_seller")
  tags            String[]             @default([])
  searchKeywords  String?              @map("search_keywords")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category              Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items                 PackItem[]
  attributes            PackAttribute[]
  images                PackImage[]
  allowedAddOns         PackAllowedAddOn[]
  compatibilityProfiles PackCompatibilityProfile[]
  recommendationResults RecommendationResult[]
  orders                Order[]                    @relation("SelectedPackOrders")
  orderItems            OrderItem[]                @relation("PackOrderItems")
  configurations        PackConfiguration[]        @relation("PackConfigurations")
  wishlistItems         WishlistItem[]
  reviews               Review[]

  @@index([status])
  @@index([isActive])
  @@index([priority])
  @@index([minBudget, maxBudget])
  @@index([categoryId])
  @@index([tier])
  @@index([occasion])
  @@index([experienceLevel])
  @@index([isFeatured])
  @@index([isNew])
  @@index([isBestSeller])
  @@map("packs")
}

model PackItem {
  id                 String        @id @default(uuid()) @db.Uuid
  packId             String        @map("pack_id") @db.Uuid
  productId          String        @map("product_id") @db.Uuid
  productReferenceId String?       @map("product_reference_id") @db.Uuid
  quantity           Int           @default(1)
  selectionMode      SelectionMode @default(AUTO_BEST_REFERENCE) @map("selection_mode")
  isRequired         Boolean       @default(true) @map("is_required")
  sortOrder          Int           @default(0) @map("sort_order")

  // Pack Core Evolution (Phase 2) — additive role taxonomy & customization rules.
  // Foundation-only: `selectionMode`/`isRequired` remain authoritative at runtime.
  role               PackItemRole @default(FIXED)
  minQuantity        Int?         @map("min_quantity")
  maxQuantity        Int?         @map("max_quantity")
  quantityEditable   Boolean      @default(false) @map("quantity_editable")
  removalAllowed     Boolean      @default(false) @map("removal_allowed")
  replacementAllowed Boolean      @default(false) @map("replacement_allowed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pack             Pack              @relation(fields: [packId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productReference ProductReference? @relation(fields: [productReferenceId], references: [id], onDelete: Restrict)

  allowedReferences         PackItemAllowedReference[]
  recommendationResultItems RecommendationResultItem[]

  @@index([packId])
  @@index([productId])
  @@index([productReferenceId])
  @@index([selectionMode])
  @@index([role])
  @@map("pack_items")
}

model PackAttribute {
  id                String    @id @default(uuid()) @db.Uuid
  packId            String    @map("pack_id") @db.Uuid
  attributeGroupId  String    @map("attribute_group_id") @db.Uuid
  attributeOptionId String    @map("attribute_option_id") @db.Uuid
  matchType         MatchType @default(COMPATIBLE) @map("match_type")
  scoreValue        Int       @default(0) @map("score_value")
  isHardFilter      Boolean   @default(false) @map("is_hard_filter")
  createdAt         DateTime  @default(now()) @map("created_at")

  pack            Pack            @relation(fields: [packId], references: [id], onDelete: Cascade)
  attributeGroup  AttributeGroup  @relation(fields: [attributeGroupId], references: [id], onDelete: Restrict)
  attributeOption AttributeOption @relation(fields: [attributeOptionId], references: [id], onDelete: Restrict)

  @@unique([packId, attributeGroupId, attributeOptionId])
  @@index([packId])
  @@index([attributeGroupId])
  @@index([attributeOptionId])
  @@index([matchType])
  @@map("pack_attributes")
}

/**
 * Pack Core Evolution (Phase 2) — additive customization foundation tables.
 * These store the *allowed* selections for future customizable Packs. They are
 * foundation data only and are NOT consumed by recommendation, pricing, cart,
 * checkout, order, or stock logic in this phase.
 */

model PackItemAllowedReference {
  id                 String   @id @default(uuid()) @db.Uuid
  packItemId         String   @map("pack_item_id") @db.Uuid
  productReferenceId String   @map("product_reference_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  packItem         PackItem         @relation(fields: [packItemId], references: [id], onDelete: Cascade)
  productReference ProductReference @relation(fields: [productReferenceId], references: [id], onDelete: Cascade)

  @@unique([packItemId, productReferenceId])
  @@index([packItemId])
  @@index([productReferenceId])
  @@map("pack_item_allowed_references")
}

model PackAllowedAddOn {
  id                 String   @id @default(uuid()) @db.Uuid
  packId             String   @map("pack_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  productReferenceId String?  @map("product_reference_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")

  pack             Pack              @relation(fields: [packId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productReference ProductReference? @relation(fields: [productReferenceId], references: [id], onDelete: Cascade)

  @@unique([packId, productId, productReferenceId])
  @@index([packId])
  @@index([productId])
  @@index([productReferenceId])
  @@map("pack_allowed_add_ons")
}

/**
 * Pack Core Evolution (Phase 2.5) — Pack Compatibility Profile foundation.
 * Declares, per Pack and per supported criterion, which canonical customer-answer
 * values a Pack is suitable for. Stored as normalized links to canonical
 * AttributeOption records (single source of truth shared with the quiz) — never
 * free text. This data is admin-managed foundation only and is NOT consumed by
 * the recommendation engine, scoring, filtering, pricing, cart, checkout, order,
 * or stock logic in this phase. A missing profile row for a (pack, criterion)
 * pair means UNCONFIGURED.
 */
model PackCompatibilityProfile {
  id        String                     @id @default(uuid()) @db.Uuid
  packId    String                     @map("pack_id") @db.Uuid
  criterion PackCompatibilityCriterion
  mode      PackCompatibilityMode      @default(RESTRICTED)
  createdAt DateTime                   @default(now()) @map("created_at")
  updatedAt DateTime                   @updatedAt @map("updated_at")

  pack   Pack                     @relation(fields: [packId], references: [id], onDelete: Cascade)
  values PackCompatibilityValue[]

  @@unique([packId, criterion])
  @@index([packId])
  @@index([criterion])
  @@map("pack_compatibility_profiles")
}

model PackCompatibilityValue {
  id                String   @id @default(uuid()) @db.Uuid
  profileId         String   @map("profile_id") @db.Uuid
  attributeOptionId String   @map("attribute_option_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  profile         PackCompatibilityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  attributeOption AttributeOption          @relation(fields: [attributeOptionId], references: [id], onDelete: Restrict)

  @@unique([profileId, attributeOptionId])
  @@index([profileId])
  @@index([attributeOptionId])
  @@map("pack_compatibility_values")
}

/**
 * Pack Core Evolution (Phase 6) — persisted, server-authoritative Pack
 * configuration. Created only after {@link validatePackConfiguration} passes, so
 * a stored row always reflects a valid, server-recomputed composition and price
 * (never a client-supplied price). The immutable `validationResult` JSON freezes
 * the validator output at persistence time; `items` capture the normalized
 * server-calculated composition (selected references, quantities, removed
 * optional items, and added add-ons). A configuration is revalidated again at
 * checkout before an order is created.
 */
model PackConfiguration {
  id               String                      @id @default(uuid()) @db.Uuid
  sourcePackId     String                      @map("source_pack_id") @db.Uuid
  sourceType       PackConfigurationSourceType @default(CUSTOMIZED) @map("source_type")
  // Pack Core Evolution (Phase 9) — additive, nullable link to the persisted
  // RecommendationResult a QUIZ_RECOMMENDED configuration was created from. Null
  // for all CUSTOMIZED (Phase 6) configurations. SetNull on delete so historical
  // configurations survive if the recommendation session is later pruned.
  recommendationResultId String?                @map("recommendation_result_id") @db.Uuid
  finalPrice       Decimal                     @map("final_price") @db.Decimal(10, 2)
  currency         String                      @default("MAD") @db.Char(3)
  minAllowedPrice  Decimal?                    @map("min_allowed_price") @db.Decimal(10, 2)
  isValid          Boolean                     @default(true) @map("is_valid")
  stockStatus      String                      @map("stock_status") @db.VarChar(20)
  validationResult Json                        @map("validation_result")
  // Pack Core Evolution (Phase 8B) — opt-in public share capability. Null until
  // the configuration is explicitly shared; once minted it is a unique, opaque
  // token that resolves the read-only, customer-safe shared view. No customer,
  // quiz, validation, or cost data is ever exposed through it.
  shareToken       String?                     @unique @map("share_token") @db.VarChar(64)
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  sourcePack           Pack                    @relation("PackConfigurations", fields: [sourcePackId], references: [id], onDelete: Restrict)
  recommendationResult RecommendationResult?   @relation("RecommendedConfigurations", fields: [recommendationResultId], references: [id], onDelete: SetNull)
  items                PackConfigurationItem[]
  orders               Order[]                 @relation("PackConfigurationOrders")

  @@index([sourcePackId])
  @@index([sourceType])
  @@index([recommendationResultId])
  @@map("pack_configurations")
}

/**
 * Pack Core Evolution (Phase 6) — one normalized line of a persisted
 * PackConfiguration. `role` stores the PackItemRole for base items or the
 * literal "ADD_ON" for add-ons. `productId`/`productReferenceId` are stored as
 * plain identifiers (snapshot-style, no hard FK) so the configuration stays
 * historically readable even if the underlying product/reference later changes;
 * live existence/stock/price are re-checked from the source Pack at checkout.
 */
model PackConfigurationItem {
  id                 String   @id @default(uuid()) @db.Uuid
  configurationId    String   @map("configuration_id") @db.Uuid
  packItemId         String?  @map("pack_item_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  productReferenceId String?  @map("product_reference_id") @db.Uuid
  role               String   @db.VarChar(30)
  quantity           Int      @default(1)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal          Decimal  @map("line_total") @db.Decimal(10, 2)
  isAddOn            Boolean  @default(false) @map("is_add_on")
  removed            Boolean  @default(false) @map("removed")
  createdAt          DateTime @default(now()) @map("created_at")

  configuration PackConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)

  @@index([configurationId])
  @@index([productId])
  @@index([productReferenceId])
  @@map("pack_configuration_items")
}

/**
 * =========================================================
 * 5. RECOMMENDATION ENGINE
 * =========================================================
 */

model RecommendationRule {
  id               String                      @id @default(uuid()) @db.Uuid
  code             String                      @unique @db.VarChar(100)
  name             String                      @db.VarChar(160)
  targetType       RecommendationTargetType    @map("target_type")
  attributeGroupId String?                     @map("attribute_group_id") @db.Uuid
  conditionType    RecommendationConditionType @map("condition_type")
  scoreValue       Int                         @default(0) @map("score_value")
  weight           Decimal                     @default(1.0) @db.Decimal(5, 2)
  isActive         Boolean                     @default(true) @map("is_active")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")

  attributeGroup AttributeGroup? @relation(fields: [attributeGroupId], references: [id], onDelete: SetNull)

  @@index([targetType])
  @@index([attributeGroupId])
  @@index([conditionType])
  @@index([isActive])
  @@map("recommendation_rules")
}

model RecommendationSession {
  id                    String               @id @default(uuid()) @db.Uuid
  customerProfileId     String               @map("customer_profile_id") @db.Uuid
  algorithmVersion      String               @default("v1") @map("algorithm_version") @db.VarChar(20)
  totalCandidatePacks   Int                  @default(0) @map("total_candidate_packs")
  totalRecommendedPacks Int                  @default(0) @map("total_recommended_packs")
  status                RecommendationStatus @default(PENDING)
  createdAt             DateTime             @default(now()) @map("created_at")

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  results RecommendationResult[]

  @@index([customerProfileId])
  @@index([status])
  @@index([createdAt])
  @@map("recommendation_sessions")
}

model RecommendationResult {
  id                      String   @id @default(uuid()) @db.Uuid
  recommendationSessionId String   @map("recommendation_session_id") @db.Uuid
  packId                  String   @map("pack_id") @db.Uuid
  rank                    Int
  totalScore              Int      @default(0) @map("total_score")
  matchPercentage         Decimal  @default(0) @map("match_percentage") @db.Decimal(5, 2)
  isSelected              Boolean  @default(false) @map("is_selected")
  reasonSummary           String?  @map("reason_summary")
  reasonJson              Json?    @map("reason_json")
  createdAt               DateTime @default(now()) @map("created_at")

  recommendationSession RecommendationSession @relation(fields: [recommendationSessionId], references: [id], onDelete: Cascade)
  pack                  Pack                  @relation(fields: [packId], references: [id], onDelete: Restrict)

  items          RecommendationResultItem[]
  orders         Order[]
  // Pack Core Evolution (Phase 9) — QUIZ_RECOMMENDED configurations created from
  // this recommendation result (customer selected required options, then this
  // recommended Pack was persisted as a configuration).
  configurations PackConfiguration[]        @relation("RecommendedConfigurations")

  @@unique([recommendationSessionId, packId])
  @@index([recommendationSessionId, rank])
  @@index([packId])
  @@index([isSelected])
  @@map("recommendation_results")
}

model RecommendationResultItem {
  id                         String   @id @default(uuid()) @db.Uuid
  recommendationResultId     String   @map("recommendation_result_id") @db.Uuid
  packItemId                 String   @map("pack_item_id") @db.Uuid
  productId                  String   @map("product_id") @db.Uuid
  selectedProductReferenceId String   @map("selected_product_reference_id") @db.Uuid
  quantity                   Int      @default(1)
  itemScore                  Int      @default(0) @map("item_score")
  reasonJson                 Json?    @map("reason_json")
  createdAt                  DateTime @default(now()) @map("created_at")

  recommendationResult     RecommendationResult @relation(fields: [recommendationResultId], references: [id], onDelete: Cascade)
  packItem                 PackItem             @relation(fields: [packItemId], references: [id], onDelete: Restrict)
  product                  Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  selectedProductReference ProductReference     @relation(fields: [selectedProductReferenceId], references: [id], onDelete: Restrict)

  @@index([recommendationResultId])
  @@index([packItemId])
  @@index([productId])
  @@index([selectedProductReferenceId])
  @@map("recommendation_result_items")
}

/**
 * =========================================================
 * 6. CUSTOMERS / ORDERS
 * =========================================================
