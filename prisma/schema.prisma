  skuSnapshot               String?  @map("sku_snapshot") @db.VarChar(120)
  variationSnapshot         String?  @map("variation_snapshot") @db.VarChar(160)
  productImageUrlSnapshot   String?  @map("product_image_url_snapshot") @db.Text
  brandNameSnapshot         String?  @map("brand_name_snapshot") @db.VarChar(120)
  unitPriceSnapshot         Decimal  @map("unit_price_snapshot") @db.Decimal(10, 2)
  originalUnitPriceSnapshot Decimal? @map("original_unit_price_snapshot") @db.Decimal(10, 2)
  quantity                  Int      @default(1)
  totalPrice                Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt                 DateTime @default(now()) @map("created_at")

  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pack             Pack?            @relation("PackOrderItems", fields: [packId], references: [id], onDelete: SetNull)
  product          Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  productReference ProductReference @relation(fields: [productReferenceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([packId])
  @@index([productId])
  @@index([productReferenceId])
  @@map("order_items")
}

